{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "summarizer",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "70f16665c7d3d224611414d8fb2a336b",
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "summarizer",
      "database_id": "119cf4cb-6057-4c47-a8ce-0ab03314b855",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "POSTERS", "bucket_name": "summarizer-posters" }],
  // On-the-fly resize for rail thumbs. Fullscreen stage always serves the original.
  "images": { "binding": "IMAGES" },
  // One SummaryJob per normalized URL. This is the port of background.js's job store:
  // the DO owns the job and stays alive while the OpenRouter fetch is in flight, which is
  // what preserves "keeps generating after you close the tab". ctx.waitUntil() would only
  // buy 30s past disconnect — nowhere near a long reasoning generation.
  "durable_objects": {
    "bindings": [
      { "name": "JOB", "class_name": "SummaryJob" },
      // Per-summary chat agent (@cloudflare/ai-chat). Binding name is kebab-cased by
      // routeAgentRequest into the /agents/summary-chat/* URL space — don't rename casually.
      { "name": "SummaryChat", "class_name": "SummaryChat" },
      { "name": "WIKI_PAGE", "class_name": "WikiPage" },
      // Binding name must stay "WikiChat": routeAgentRequest maps it to /agents/wiki-chat/<thread>.
      { "name": "WikiChat", "class_name": "WikiChat" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SummaryJob"] },
    { "tag": "v2", "new_sqlite_classes": ["SummaryChat"] },
    { "tag": "v3", "new_sqlite_classes": ["WikiPage", "WikiChat"] }
  ],
  // Waiting on OpenRouter is I/O, not CPU, so this ceiling is only for markdown/JSON work.
  "limits": { "cpu_ms": 300000 },
  // Wiki card extraction (src/wiki.ts). Shared by backfill (/api/wiki/enqueue) and live ingest.
  "queues": {
    "producers": [{ "binding": "WIKI_INGEST", "queue": "wiki-ingest" }],
    "consumers": [
      {
        "queue": "wiki-ingest",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_concurrency": 8,
        "max_retries": 3,
        "dead_letter_queue": "wiki-ingest-dlq"
      }
    ]
  },
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "WIKI_VEC", "index_name": "summarizer-wiki" }],
  "workflows": [
    { "name": "wiki-build", "binding": "WIKI_BUILD", "class_name": "WikiBuild" },
    { "name": "wiki-garden", "binding": "WIKI_GARDEN", "class_name": "WikiGarden" }
  ],
  // Weekly gardeners: Sunday 17:00 UTC = Monday 3-4am Sydney.
  "triggers": { "crons": ["0 17 * * SUN"] }
}
