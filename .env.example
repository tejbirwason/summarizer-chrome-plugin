# Optional: Webshare proxy credentials for yt-summary.py (YouTube transcript native host).
# Worker secrets (OPENROUTER_API_KEY, FAL_KEY, APP_TOKEN) live in Cloudflare (`wrangler secret put`)
# and locally in worker/.dev.vars. Cloudflare deploy creds live in worker/.env.
WEBSHARE_PROXY_USERNAME=your-webshare-username
WEBSHARE_PROXY_PASSWORD=your-webshare-password
